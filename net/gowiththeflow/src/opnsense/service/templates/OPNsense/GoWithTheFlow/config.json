{#
 # DO NOT EDIT THIS FILE -- OPNsense auto-generated file
 # Consumed by gowiththeflowd.py at startup. Rendered on every
 # ServiceController::reconfigureAction() call (settings save + apply).
 #}
{% set capture_ifaces = [] %}
{% for ifn in helpers.physical_interfaces((GoWithTheFlow.general.captureInterfaces or '').split(',')) %}
{%   do capture_ifaces.append('"' + ifn + '"') %}
{% endfor %}
{% set subnets = [] %}
{% for subnet in (GoWithTheFlow.general.localSubnets or '').split(',') %}
{%   if subnet.strip() %}
{%     do subnets.append('"' + subnet.strip() + '"') %}
{%   endif %}
{% endfor %}
{% set tls_ports = [] %}
{% for port in (GoWithTheFlow.hostname.extraTlsPorts or '').split(',') %}
{%   if port.strip() %}
{%     do tls_ports.append(port.strip()) %}
{%   endif %}
{% endfor %}
{% set overrides = [] %}
{% for row in helpers.toList('GoWithTheFlow.staticOverrides') %}
{%   do overrides.append('["' + row.cidr + '", "' + row.hostname + '"]') %}
{% endfor %}
{
  "enabled": {{ 1 if GoWithTheFlow.general.enabled == '1' else 0 }},
  "capture_interfaces": [{{ capture_ifaces|join(', ') }}],
  "local_subnets": [{{ subnets|join(', ') }}],
  "extra_tls_ports": [{{ tls_ports|join(', ') }}],
  "static_overrides": [{{ overrides|join(', ') }}],
  "enable_dns_sniffing": {{ 1 if GoWithTheFlow.hostname.enableDnsSniffing == '1' else 0 }},
  "enable_sni_sniffing": {{ 1 if GoWithTheFlow.hostname.enableSniSniffing == '1' else 0 }},
  "enable_ptr_fallback": {{ 1 if GoWithTheFlow.hostname.enablePtrFallback == '1' else 0 }},
  "raw_retention_days": {{ GoWithTheFlow.general.rawRetentionDays }},
  "rollup_hourly_retention_days": {{ GoWithTheFlow.general.rollupHourlyRetentionDays }},
  "rollup_daily_retention_days": {{ GoWithTheFlow.general.rollupDailyRetentionDays }},
  "cpu_limit_pct": {{ GoWithTheFlow.general.cpuLimitPct }},
  "mem_limit_mb": {{ GoWithTheFlow.general.memLimitMB }}
}
