<model>
    <mount>/GoWithTheFlow</mount>
    <description>GoWithTheFlow settings</description>
    <version>1.2.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
            </enabled>
            <captureInterfaces type="InterfaceField">
                <Multiple>Y</Multiple>
            </captureInterfaces>
            <localSubnets type="NetworkField">
                <AsList>Y</AsList>
                <Required>N</Required>
            </localSubnets>
            <rawRetentionDays type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>365</MaximumValue>
                <Default>10</Default>
                <Required>Y</Required>
            </rawRetentionDays>
            <rollupHourlyRetentionDays type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>3650</MaximumValue>
                <Default>8</Default>
                <Required>Y</Required>
            </rollupHourlyRetentionDays>
            <rollupDailyRetentionDays type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>36500</MaximumValue>
                <Default>32</Default>
                <Required>Y</Required>
            </rollupDailyRetentionDays>
            <dnsQueryLogRetentionDays type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>365</MaximumValue>
                <Default>7</Default>
                <Required>Y</Required>
            </dnsQueryLogRetentionDays>
            <cpuLimitPct type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100</MaximumValue>
                <Default>10</Default>
                <Required>Y</Required>
            </cpuLimitPct>
            <memLimitMB type="IntegerField">
                <MinimumValue>16</MinimumValue>
                <MaximumValue>16384</MaximumValue>
                <Default>256</Default>
                <Required>Y</Required>
            </memLimitMB>
            <debugLogging type="BooleanField">
                <Default>0</Default>
            </debugLogging>
            <!-- Both off by default; see reservation_gate.py's own
                 module docstring for why this is by far the
                 highest blast radius feature this plugin has: a bug
                 risks the whole LAN's internet access, not one
                 device's. ARP pinning is an independent hardening
                 layer on top of the gate, not implied by it.

                 Note for future edits: an XML comment body must never
                 contain two consecutive hyphen characters, a hard XML
                 spec rule; this exact comment broke model loading
                 once already by using this project's usual prose dash
                 convention here, twice in a row, including in the
                 first attempt to explain the very same mistake. -->
            <enableReservationGate type="BooleanField">
                <Default>0</Default>
            </enableReservationGate>
            <enableArpPinning type="BooleanField">
                <Default>0</Default>
            </enableArpPinning>
        </general>
        <hostname>
            <enableDnsSniffing type="BooleanField">
                <Default>1</Default>
            </enableDnsSniffing>
            <enableSniSniffing type="BooleanField">
                <Default>1</Default>
            </enableSniSniffing>
            <enablePtrFallback type="BooleanField">
                <Default>1</Default>
            </enablePtrFallback>
            <enableDpi type="BooleanField">
                <Default>0</Default>
            </enableDpi>
            <enableDnsQueryLog type="BooleanField">
                <Default>1</Default>
            </enableDnsQueryLog>
            <extraTlsPorts type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9,\s]*$/</Mask>
                <ValidationMessage>Please enter a comma-separated list of port numbers.</ValidationMessage>
            </extraTlsPorts>
        </hostname>
        <staticOverrides type="ArrayField">
            <cidr type="NetworkField">
                <Required>Y</Required>
            </cidr>
            <hostname type="HostnameField">
                <Required>Y</Required>
            </hostname>
        </staticOverrides>
    </items>
</model>
