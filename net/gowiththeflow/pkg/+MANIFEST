{
  "name": "os-gowiththeflow",
  "version": "1.9.10",
  "origin": "net/os-gowiththeflow",
  "comment": "Per-host connection and bandwidth tracking with hostname resolution, scheduled host and domain blocking.",
  "desc": "Go With The Flow tracks, per local host, which remote hosts it talks to and how many bytes in/out, both live and historically. Remote hostnames are resolved via passive DNS and TLS SNI observation rather than raw IPs alone. Scheduled host and domain blocking is supported, with the ability to block by hostname, domain, or IP address. The package also provides a web interface for viewing and managing the tracked data and blocking rules.",
  "maintainer": "https://github.com/tobydoig",
  "www": "https://github.com/tobydoig/opnsense-gowiththeflow",
  "prefix": "/",
  "categories": ["net"],
  "deps": {
    "py313-scapy": {
      "origin": "net/scapy",
      "version": "2.7.0"
    },
    "ndpi": {
      "origin": "net/ndpi",
      "version": "5.0.d20251224,1"
    }
  },
  "scripts": {
    "post-install": "#!/bin/sh\nservice configd restart 2>/dev/null || true\nrm -f /var/lib/php/tmp/opnsense_menu_cache.xml\nconfigctl template reload OPNsense/GoWithTheFlow >/dev/null 2>&1\nmkdir -p /var/db/gowiththeflow\n[ -f /var/db/gowiththeflow/blocked_hosts.tbl ] || touch /var/db/gowiththeflow/blocked_hosts.tbl\nconfigctl filter reload >/dev/null 2>&1 || true\nif [ -f /var/etc/gowiththeflow.json ] && /usr/local/bin/jq -e '.enabled == 1' /var/etc/gowiththeflow.json >/dev/null 2>&1; then\n    /usr/local/etc/rc.d/gowiththeflow onestart >/dev/null 2>&1 || true\nfi\n",
    "pre-deinstall": "#!/bin/sh\n/usr/local/etc/rc.d/gowiththeflow onestop 2>/dev/null || true\n",
    "post-deinstall": "#!/bin/sh\nconfigctl filter reload >/dev/null 2>&1 || true\n/sbin/pfctl -t gowiththeflow_blocked -T kill >/dev/null 2>&1 || true\n"
  }
}
